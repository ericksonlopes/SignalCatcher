# --- Database (required) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_DATABASE=signalcatcher

# --- Downloads (required) ---
# Base directory where yt-dlp writes the downloaded files.
DOWNLOAD_YOUTUBE_PATH=./youtube

# Private service-account JSON or authorized_user OAuth token generated by the CLI.
GOOGLE_DRIVE_CREDENTIALS_PATH=./service_account.json
# Compose host path; mounted read-only into API and worker containers.
GOOGLE_DRIVE_CREDENTIALS_FILE=/media/eriberry/SSD_1/signalcatcher-505023-dcafb0efaeab.json
# For a personal My Drive account, point this host path to the CLI-generated token instead:
# GOOGLE_DRIVE_CREDENTIALS_FILE=/media/eriberry/SSD_1/drive-auth/token.json
GOOGLE_DRIVE_FOLDER_ID=15UskOqNHVgjXmeN1URSf8ZP300GM-BSu

# --- Logging (optional) ---
# Comma-separated levels that reach the console. Empty or unset lets everything through.
LIST_LOG_LEVELS=ERROR,WARNING,INFO,DEBUG

# --- CORS (optional) ---
# Comma-separated browser origins allowed to call the API. The default below only covers
# local development, so set this to your frontend's origin when deploying.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Voice Monkey notification (optional) ---
# When either is missing, the "new videos detected" announcement is skipped with a warning.
VOICE_MONKEY_API_TOKEN=
VOICE_MONKEY_NEW_VIDEO_FOR_DOWNLOAD_MONKEY_ID=

# Worker reservations and retry policy
PROCESSING_LEASE_SECONDS=300
MAX_PROCESSING_ATTEMPTS=5
RETRY_BASE_SECONDS=300
RETRY_MAX_SECONDS=86400
WORKER_HEARTBEAT_MAX_AGE=60
