# --- Database (required) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_DATABASE=signalcatcher

# --- Downloads (required) ---
# Base directory where yt-dlp writes the downloaded files.
DOWNLOAD_YOUTUBE_PATH=./youtube

# --- Logging (optional) ---
# Comma-separated levels that reach the console. Empty or unset lets everything through.
LIST_LOG_LEVELS=ERROR,WARNING,INFO,DEBUG

# --- CORS (optional) ---
# Comma-separated browser origins allowed to call the API. The default below only covers
# local development, so set this to your frontend's origin when deploying.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Diarization service (optional) ---
# Base URL of the external diarization API.
DIARIZATION_API_URL=http://localhost:8001

# --- Voice Monkey notification (optional) ---
# When either is missing, the "new videos detected" announcement is skipped with a warning.
VOICE_MONKEY_API_TOKEN=
VOICE_MONKEY_NEW_VIDEO_FOR_DOWNLOAD_MONKEY_ID=
